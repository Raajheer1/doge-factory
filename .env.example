# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
# Required for Claude-generated personas/call plans. Sample personas do not need it.
ANTHROPIC_API_KEY=
# Generated agents (voice_agents/planner.py). PLANNER_MODEL defaults to gpt-6.1-terra.
OPENAI_API_KEY=
# PLANNER_MODEL=
# PLANNER_EFFORT=medium
# PLANNER_WORKERS=12
# Reads finished calls for confidence scores (docs/confidence.md). Defaults to gpt-6-luna.
# CONFIDENCE_MODEL=
# Call logs sync to Supabase (tables: calls, call_turns). The secret key stays server-side.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Imported Twilio number in ElevenLabs (Agents → Phone Numbers)
ELEVENLABS_PHONE_NUMBER_ID=phnum_4001m7cjyrdbe6qssm844vebws0h

# Safety rail for the demo: calls to any other number are refused.
# Comma-separated E.164 numbers.
ALLOWED_TO_NUMBERS=+19727652721

# Copy this file to .env and provide your Vercel AI Gateway API key.
AI_GATEWAY_API_KEY=VCK__

HYDRADB_API_KEY=
# Optional settings.
# AI_GATEWAY_MODEL=zai/glm-5.3-flash
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# ADDR=127.0.0.1:8080
