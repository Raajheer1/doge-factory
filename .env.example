# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
# Optional: leave unset to use your `ant auth login` profile instead.
# ANTHROPIC_API_KEY=

# Imported Twilio number in ElevenLabs (Agents → Phone Numbers)
ELEVENLABS_PHONE_NUMBER_ID=phnum_4001m7cjyrdbe6qssm844vebws0h

# Safety rail for the demo: calls to any other number are refused.
# Comma-separated E.164 numbers.
ALLOWED_TO_NUMBERS=+19727652721

# Copy this file to .env and provide your Vercel AI Gateway API key.
AI_GATEWAY_API_KEY=VCK__


